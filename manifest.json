{
  "manifest_version": 3,
  "name": "VoiceIn",
  "version": "1.1.0",
  "description": "Dictate into any text field with a clean, glassy voice overlay and a keyboard shortcut.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoiceIn settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Start or stop voice input in the focused field"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
